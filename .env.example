# ===== API Configuration =====
# URL de l'API en mode debug (développement local)
API_DEBUG_BASE_URL=http://localhost:8081

# URL de l'API en production
API_PROD_BASE_URL=https://api.example.com

# ===== Upload Script (upload.py) =====
# Token d'authentification pour l'upload des APK
API_UPLOAD_TOKEN=your_token_here

# ===== Mapbox (carte Circuit) =====
# Token public Mapbox (pk.) pour afficher les tuiles de carte
MAPBOX_TOKEN=your_mapbox_public_token_here

# ===== Google Sign-In =====
# Client OAuth *Web* du projet Google Cloud : audience (aud) de l'ID token attendue par l'API.
# Les clients Android / iOS servent uniquement au SDK natif, jamais comme audience.
GOOGLE_WEB_CLIENT_ID=703495171118-b36esibhshnu9ubakjai6v2a23q5acns.apps.googleusercontent.com
# Client OAuth *iOS* (bundle ID) — requis uniquement sur iOS/macOS, ignoré sur Android.
# Renseigné automatiquement (avec Info.plist) par : ./configure_google_ios.sh <IOS_CLIENT_ID>
GOOGLE_IOS_CLIENT_ID=
